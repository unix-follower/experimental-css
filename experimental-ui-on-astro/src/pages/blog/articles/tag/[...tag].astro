---
import MainLayout from "@/layouts/BlogMainLayout.astro"
import ArticleCard from "@/components/blog/ArticleCard.astro"
import { getCollection } from "astro:content"
import type { CollectionEntry } from "astro:content"
import { capitalize } from "@/utils/blog/utils"

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog")

  // Collect every unique tag across all articles
  const uniqueTags = [...new Set(blogEntries.flatMap((entry) => entry.data.tags))]

  return uniqueTags.map((tag) => ({
    params: { tag },
    props: { tag },
  }))
}

const { tag } = Astro.params

if (tag === undefined) {
  throw new Error("Tag is required")
}

const allBlogArticles: CollectionEntry<"blog">[] = (await getCollection("blog")).sort(
  (prev: CollectionEntry<"blog">, next: CollectionEntry<"blog">) =>
    next.data.pubDate.valueOf() - prev.data.pubDate.valueOf(),
)

const tagArticles = allBlogArticles.filter((article) => article.data.tags.includes(tag))
---

<MainLayout>
  <a
    href="/blog/articles"
    class="inline-block bg-gray-100 p-2 mb-6 hover:bg-indigo-500 hover:text-white"
    >Back To Articles</a
  >
  <h1 class="text-2xl pb-3">#{capitalize(tag)}</h1>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {tagArticles.map((article) => <ArticleCard article={article} />)}
  </div>
</MainLayout>
