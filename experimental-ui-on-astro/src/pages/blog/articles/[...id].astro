---
import { getCollection } from "astro:content"
import MainLayout from "@/layouts/BlogMainLayout.astro"
import Tags from "@/components/blog/Tags.astro"
import { getEntry, render } from "astro:content"
import { formatDate } from "@/utils/blog/utils"

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog")
  return blogEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }))
}

const { id } = Astro.params

if (id === undefined) {
  throw new Error("ID is required")
}

const entry = await getEntry("blog", id)

if (entry === undefined) {
  return Astro.redirect("/blog/404")
}

const { Content } = await render(entry)
---

<MainLayout>
  <a
    href="/blog/articles"
    class="inline-block bg-gray-100 p-2 mb-6 hover:bg-indigo-500 hover:text-white"
    >Back To Articles</a
  >
  <article>
    <h1 class="text-4xl font-bold mb-2">{entry.data.title}</h1>
    <h3 class="text-lg mb-2">Written by {entry.data.author} on {formatDate(entry.data.pubDate)}</h3>
    <Tags tags={entry.data.tags} />
    <img
      src={"/images/blog/" + entry.data.image}
      alt="Article Image"
      class="w-full h-auto rounded-xl my-6"
    />
    <Content />
  </article>
</MainLayout>

<style is:global>
  p {
    margin: 20px 0;
  }

  h2 {
    margin: 20px 0;
    font-size: 1.8rem;
  }
</style>
